{
  "private": true,
  "name": "ainc-gatsby-sanity-studio",
  "version": "1.0.6",
  "main": "package.json",
  "author": "Sanity <hello@sanity.io>",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "sanity dev",
    "build": "sanity build",
    "start": "sanity start",
    "clone": "sanity dataset export production production && sanity dataset import production/production.tar.gz development --replace",
    "export-db": "SANITY_AUTH_TOKEN=$SANITY_DEPLOY_STUDIO_TOKEN sanity dataset export production ./production.tar.gz",
    "import-db": "SANITY_AUTH_TOKEN=$SANITY_DEPLOY_STUDIO_TOKEN sanity dataset import ./production.tar.gz dev --replace",
    "format": "prettier-eslint --write \"**/*.js\" \"!node_modules/**\"",
    "graphql-deploy": "sanity graphql deploy --playground",
    "lint": "eslint .",
    "test": "sanity check"
  },
  "dependencies": {
    "@portabletext/react": "^2.0.2",
    "@sanity/cli": "^8",
    "@sanity/ui": "^4",
    "@sanity/vision": "^6",
    "date-fns": "^2.27.0",
    "easymde": "^2.18.0",
    "http-proxy-agent": "^7.0.2",
    "jsdom": "^22.1.0",
    "prop-types": "^15.8.1",
    "react": "^19.3.0",
    "react-calendly": "^4.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "^4.3.1",
    "react-markdown": "^8.0.7",
    "rehype-raw": "^6.1.1",
    "remark-gfm": "^3.0.1",
    "sanity": "^6",
    "sanity-plugin-markdown": "^9",
    "sanity-plugin-media": "^6",
    "sanity-plugin-tags-v4": "^1",
    "styled-components": "^6.1.15"
  },
  "devDependencies": {
    "babel-eslint": "^10.1.0",
    "eslint": "~7.18.0",
    "eslint-config-standard": "^16.0.3",
    "eslint-config-standard-react": "^11.0.1",
    "eslint-plugin-import": "^2.25.3",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^5.2.0",
    "eslint-plugin-react": "^7.27.1",
    "eslint-plugin-standard": "^5.0.0",
    "prettier-eslint-cli": "^5.0.1"
  }
}
